# Copy this file to .env and fill in your real values.
# The database schema is pinned to "nurture" via the ?schema= query param / DB_SCHEMA.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=nurture
CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Admin Authentication ---
# Use a plain text password - it will be hashed with bcrypt at startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=change-this-to-a-long-random-string-in-production