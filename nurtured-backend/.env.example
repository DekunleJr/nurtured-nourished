# Copy this file to .env and fill in your real values.
# The database schema is pinned to "nurture" via the ?schema= query param / DB_SCHEMA.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=nurture
CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Admin Authentication ---
# Either set ADMIN_PASSWORD as plain text (it will be hashed with bcrypt at
# startup) OR set ADMIN_PASSWORD_HASH to a pre-computed bcrypt hash so the
# plain password never has to be stored in the environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# ADMIN_PASSWORD_HASH=$2b$12$...
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
JWT_SECRET=change-this-to-a-long-random-string-in-production