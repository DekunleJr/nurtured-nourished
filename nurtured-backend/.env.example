# Copy this file to .env and fill in your real values.
# The database schema is pinned to "nurture" via the ?schema= query param / DB_SCHEMA.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=nurture
CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Admin bootstrap (first admin only) ---
# Admin accounts live in the `admins` table and are managed from the dashboard
# ("Manage admins" section). These vars are used ONLY to seed the very first
# admin at startup when the table is empty. Once you can log in you can remove
# ADMIN_EMAIL/ADMIN_PASSWORD entirely.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=changeme
JWT_SECRET=change-this-to-a-long-random-string-in-production

# --- Bookings & payments (Stripe Checkout) ---
# Leave STRIPE_SECRET_KEY empty to run bookings without payments; the API then
# returns bookings in "pending_payment" state and the frontend explains that
# payment will be arranged manually.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Password-reset email delivery (replace the dummy key before production).
RESEND_API_KEY=re_dummy_replace_me
RESEND_FROM_EMAIL=Nurtured & Nourished <hello@nurturedandnourished.co.uk>
# Frontend origin used to build Stripe success/cancel return URLs.
PUBLIC_SITE_URL=http://localhost:3000