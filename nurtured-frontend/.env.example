# Next.js environment variables for the Nurtured & Nourished frontend.
# Copy this file to .env.local and fill in your values.

# --- Discovery call scheduling (Calendly) ---
# Paste your live Calendly event URL, e.g.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/15-minute-discovery-call
NEXT_PUBLIC_CALENDLY_URL=

# --- Site 2 (Go Nurture Initiative CIC) cross-links ---
NEXT_PUBLIC_CIC_URL=
NEXT_PUBLIC_CIC_NAME=Go Nurture Initiative CIC

# --- API / site ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=https://nurturedandnourished.co.uk

# --- Contact ---
NEXT_PUBLIC_SUPPORT_EMAIL=hello@nurturedandnourished.co.uk
NEXT_PUBLIC_PHONE=+44 (0) 1603 000 000

# --- Google Analytics ---
# Your GA4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# --- Social Media ---
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your-handle
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/your-company

# --- Legal / Company Details ---
NEXT_PUBLIC_COMPANY_NUMBER=XXXXXXXXXX
NEXT_PUBLIC_REGISTERED_OFFICE=[Your Registered Office Address]
NEXT_PUBLIC_DPO_EMAIL=dpo@nurturedandnourished.co.uk
NEXT_PUBLIC_REVIEW_DATE=January 2027
